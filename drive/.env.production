# Production backend environment variables for Render deployment
# Note: Vite automatically injects these during the production build ('npm run build')

# Base API URL pointing to the deployed Express backend routes
VITE_API_BASE_URL=https://shnoordrives.onrender.com/api

# Root domain of the backend for accessing uploaded static files/assets
VITE_BACKEND_URL=https://shnoordrives.onrender.com
